# Copy this file to .env and fill in the real values.
#   cp .env.example .env
#
# .env is gitignored and must never be committed. Everything here is environment- or
# org-specific, which is why none of it is hardcoded in tests/support/config.js.

# ── Target environment ──────────────────────────────────────────────────────

# Root URL of the Academy instance under test, trailing slash included.
BASE_URL=

# ── Staff logins ────────────────────────────────────────────────────────────

# Phase 1 — the onboarding specialist who bulk-onboards trainees.
ONBOARDING_EMAIL=
ONBOARDING_PASSWORD=

# Phase 2 — the trainer who adds a trainee by hand and starts the batch.
TRAINER_EMAIL=
TRAINER_PASSWORD=

# Reporting manager + team leader set on every bulk row. Must resolve to a real CRM user
# in the target environment, or the batch is created without a team leader and the Add
# Trainee form refuses with "still needed: team leader".
MANAGER_EMAIL=

# ── Trainee accounts ────────────────────────────────────────────────────────

# The temporary password a freshly onboarded trainee signs in with before the forced reset.
TRAINEE_TEMP_PASSWORD=

# Domain the platform mints trainee logins on — used to pick the address out of the
# trainee's row in the batch table. No leading @.
TRAINEE_EMAIL_DOMAIN=

# ── Batch shape ─────────────────────────────────────────────────────────────

# Exact dropdown option labels, bracketed codes included. The batch display name is
# "<Partner> <Location> <Module> <Batch No.>" with the codes stripped.
PARTNER_OPTION=
LOCATION_OPTION=

# Optional — sensible defaults are used when these are left out.
# MODULE_OPTION=Offline
# TRAINEE_COUNT=5
# BATCH_NO_MIN=100
# BATCH_NO_MAX=999